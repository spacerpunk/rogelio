# Copiar a .env.local y completar. Nunca commitear .env.local.
# Con Supabase local, `npm run db:status` muestra URL y claves.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# La usa el navegador solo para subir archivos con URLs firmadas; sin token no tiene acceso a nada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: la app no tiene login y todo el acceso a la base pasa por acá. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Cada proyecto elige su motor de texto (lectura de PDFs, guion, shot list y prompts) y su motor, modelo,
# resolución y formato de imagen (frames) desde el botón "Motores" del proyecto. Solo aparecen como
# disponibles los motores con API key y modelo completos acá. Las variables *_MODEL admiten una lista
# separada por comas: son los modelos que se pueden elegir en la UI, y el primero es el default.

# Anthropic: motor de texto Claude
ANTHROPIC_API_KEY=
# Recomendado: claude-opus-5-5
ANTHROPIC_MODEL=

# Google: motor de texto Gemini y motor de imagen Nano Banana (la misma API key)
GEMINI_API_KEY=
# Recomendado: gemini-3.8-flash (estable) o gemini-3.1-pro-preview
GEMINI_TEXT_MODEL=
# Recomendado: gemini-3.1-flash-image (Nano Banana 2) y, como opción, gemini-3-pro-image (Nano Banana Pro)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image,gemini-3-pro-image

# OpenAI: motor de texto GPT y motor de imagen GPT Image (la misma API key)
OPENAI_API_KEY=
# Recomendado: gpt-6.1-sol (o gpt-6-astra, el más capaz)
OPENAI_TEXT_MODEL=
# Recomendado: gpt-image-2.5-sunburst (precisión con referencias) o gpt-image-2.5-flare (rápido)
OPENAI_IMAGE_MODEL=

# Motores de los proyectos que todavía no eligieron uno (si no están configurados, se usa el primero que sí)
DEFAULT_TEXT_ENGINE=claude
DEFAULT_IMAGE_ENGINE=gemini

# Worker de trabajos (opcional): cuántos trabajos corre en paralelo
WORKER_CONCURRENCY=3

# Motores simulados (1 = sin claves ni costo, para probar la UI). Dejar vacío en uso real.
ENGINE_MOCK=
